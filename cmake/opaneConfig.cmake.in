# The package find_package(opane) reads.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SDL3 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/opaneTargets.cmake")

# opane_add_material, for compiling material shaders when your program builds.
include("${CMAKE_CURRENT_LIST_DIR}/CompileShaders.cmake")

# opane_set_app_icon, for giving your program an icon of its own.
include("${CMAKE_CURRENT_LIST_DIR}/AppIcon.cmake")

check_required_components(opane)
